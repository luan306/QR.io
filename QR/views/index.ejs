<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<title>Quản lý tài sản</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
<style>
  /* Layout / scanner box */
  #reader-wrap { position: relative; width: 320px; max-width: 92vw; height: 320px; max-height: 60vh; margin: auto; border-radius: 16px; overflow: hidden; background: #000; }
  #qr-video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .laser { position: absolute; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, rgba(0,255,150,0.9), rgba(0,200,255,0.9)); animation: scan 2s linear infinite; top: 0; }
  @keyframes scan { 0% { top: 0%; } 100% { top: 100%; } }
  .hidden { display: none !important; }
</style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

<header class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white p-4 flex items-center justify-between">
  <div class="flex items-center space-x-3">
    <img src="https://cdn-icons-png.flaticon.com/512/1041/1041882.png" class="w-8 h-8" alt="logo">
    <div>
      <div class="font-bold text-lg">Asset Manager</div>
      <div class="text-xs opacity-80">Quản lý & kiểm kê tài sản</div>
    </div>
  </div>
  <div class="flex items-center space-x-3">
    <div id="welcome-user" class="text-sm">👋 Xin chào</div>
    <button id="admin-btn" class="bg-yellow-400 text-gray-800 px-3 py-1 rounded-lg hidden">Trang Admin</button>
    <button onclick="logout()" class="bg-red-500 px-3 py-1 rounded-lg shadow hover:bg-red-600">Đăng xuất</button>
  </div>
</header>

<main class="flex-1 p-4 overflow-auto">

  <!-- TAB SCANNER -->
  <section id="tab-scan" class="tab text-center">
    <h2 class="text-xl font-bold mb-4 text-indigo-600">📷 Quét mã QR</h2>

    <div id="reader-wrap">
      <!-- video element for qr-scanner -->
      <video id="qr-video" playsinline muted></video>
      <div class="laser"></div>
    </div>

    <div id="scan-result" class="mt-4 text-gray-700">Chưa quét mã</div>

    <div id="add-new-btn" class="mt-4 hidden">
      <button onclick="showTab('tab-add')" class="px-6 py-3 bg-green-500 text-white rounded-xl shadow hover:bg-green-600">➕ Thêm thiết bị mới</button>
    </div>

    <div class="mt-4 flex justify-center space-x-3">
      <button id="start-btn" onclick="startScanner()" class="px-6 py-3 bg-indigo-600 text-white rounded-xl shadow hover:bg-indigo-700">Bắt đầu</button>
      <button id="stop-btn" onclick="stopScanner()" class="px-6 py-3 bg-red-500 text-white rounded-xl shadow hover:bg-red-600" disabled>Ngừng</button>
    </div>
  </section>

  <!-- TAB INVENTORY -->
  <section id="tab-inventory" class="tab hidden mt-6">
    <h2 class="text-xl font-bold mb-4 text-indigo-600">📋 Danh sách tài sản</h2>

    <div class="flex flex-col sm:flex-row sm:space-x-2 mb-3">
      <select id="device-filter" class="flex-1 p-3 rounded-xl border shadow mb-2 sm:mb-0">
        <option value="">-- Tất cả loại thiết bị --</option>
      </select>
      <input id="search" type="text" placeholder="🔍 Tìm kiếm..." class="flex-1 p-3 rounded-xl border shadow">
    </div>

    <div class="flex space-x-2 mb-4">
      <button onclick="setStatusFilter('scanned')" class="flex-1 px-4 py-2 bg-green-200 text-green-700 rounded-xl shadow hover:bg-green-300">📗 Đã quét</button>
      <button onclick="setStatusFilter('not_scanned')" class="flex-1 px-4 py-2 bg-red-200 text-red-700 rounded-xl shadow hover:bg-red-300">📕 Chưa quét</button>
      <button onclick="setStatusFilter('all')" class="flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-xl shadow hover:bg-gray-300">Tất cả</button>
    </div>

    <div id="stats" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4"></div>
    <div id="inventory-list" class="space-y-4"></div>
  </section>

  <!-- TAB ADD -->
  <section id="tab-add" class="tab hidden mt-6">
    <h2 class="text-xl font-bold mb-4 text-indigo-600">➕ Thêm thiết bị mới</h2>
    <form id="add-form" class="space-y-4">
      <input id="add-qr" name="qr_code" type="text" placeholder="Mã QR" required class="w-full p-3 rounded-xl border shadow">
      <input id="add-name" name="name" type="text" placeholder="Tên thiết bị" required class="w-full p-3 rounded-xl border shadow">
      <select id="add-device-type" name="device_type_id" required class="w-full p-3 rounded-xl border shadow">
        <option value="">-- Chọn loại thiết bị --</option>
      </select>
      <select id="add-department" name="department_id" required class="w-full p-3 rounded-xl border shadow">
        <option value="">-- Chọn bộ phận --</option>
      </select>
      <input id="add-location" name="location" type="text" placeholder="Vị trí / Ghi chú" class="w-full p-3 rounded-xl border shadow">
      <div class="flex space-x-2">
        <button type="submit" class="flex-1 bg-green-500 text-white p-3 rounded-xl shadow hover:bg-green-600">Lưu thiết bị</button>
        <button type="button" onclick="showTab('tab-inventory')" class="flex-1 bg-gray-200 text-gray-700 p-3 rounded-xl shadow hover:bg-gray-300">Hủy</button>
      </div>
    </form>
  </section>

</main>

<nav class="bg-white shadow-inner border-t flex justify-around py-2 fixed bottom-0 left-0 right-0">
  <button data-tab="tab-scan" onclick="showTab('tab-scan', this)" class="nav-btn flex flex-col items-center text-indigo-600">
    <i class="ri-qr-code-line text-2xl"></i><span class="text-sm">Quét QR</span>
  </button>
  <button data-tab="tab-inventory" onclick="showTab('tab-inventory', this)" class="nav-btn flex flex-col items-center text-gray-500">
    <i class="ri-file-list-3-line text-2xl"></i><span class="text-sm">Kiểm kê</span>
  </button>
  <button data-tab="tab-add" onclick="showTab('tab-add', this)" class="nav-btn flex flex-col items-center text-gray-500">
    <i class="ri-add-circle-line text-2xl"></i><span class="text-sm">Thêm</span>
  </button>
</nav>

<!-- Thông báo quét thành công -->
<div id="scan-success-toast"
     class="fixed bottom-10 left-1/2 transform -translate-x-1/2 bg-green-600 text-white px-5 py-3 rounded-2xl shadow-lg text-lg font-semibold hidden z-50 transition-all duration-300">
  ✅ Quét thành công!
</div>

<audio id="beep-sound" preload="auto">
  <source src="https://actions.google.com/sounds/v1/cartoon/wood_plank_flicks.ogg" type="audio/ogg">
</audio>

<!-- SCRIPT: import qr-scanner as module, then use same API logic as before -->
<script type="module">
  import QrScanner from "https://cdn.jsdelivr.net/npm/qr-scanner@1.4.2/qr-scanner.min.js";
  // QrScanner.WORKER_PATH = '/js/qr-scanner-worker.min.js'; // optional if hosting worker locally

  // App state
  let qrScanner = null;
  let scanning = false;
  let assets = []; // will be filled by loadDevices()
  let statusFilter = "all";
  let currentUser = {};
  // Prevent duplicate processing of same QR in short time
  const recentScans = new Map(); // qr -> timestamp
  const DUPLICATE_WINDOW_MS = 1500; // ignore same qr within 1.5s

  // ================== HELPERS ==================
  function now() { return Date.now(); }

  function canProcessQr(qr) {
    const t = recentScans.get(qr);
    if (!t) return true;
    return (now() - t) > DUPLICATE_WINDOW_MS;
  }
  function markQrProcessed(qr) { recentScans.set(qr, now()); }

  // ================== LOAD current user ==================
  async function loadCurrentUser(){
    try{
      const res = await fetch('/api/current-user');
      if(!res.ok) throw new Error('no current user');
      const data = await res.json();
      currentUser = data.user || data;
      if(!currentUser || !currentUser.id) {
        window.location.href = "/login";
        return;
      }
      document.getElementById("welcome-user").innerText = "👋 Xin chào, " + (currentUser.full_name || currentUser.name || 'User');
      if(currentUser.role === "admin") document.getElementById("admin-btn").classList.remove('hidden');
    }catch(err){
      console.warn('Không lấy được current user', err);
      // fallback demo user if needed
      currentUser = { id: 1, full_name: 'Demo User', role: 'admin' };
      document.getElementById("welcome-user").innerText = "👋 Xin chào, " + currentUser.full_name;
      document.getElementById("admin-btn").classList.remove('hidden');
    }
  }

  // ================== SCANNER ==================
  window.startScanner = async function(){
    if(scanning) return;
    const video = document.getElementById('qr-video');

    qrScanner = new QrScanner(video, result => {
      const decoded = (typeof result === 'string') ? result : (result.data || result);
      const qr = String(decoded).trim();
      if(!qr) return;
      if(!canProcessQr(qr)) return; // ignore duplicates in short window
      markQrProcessed(qr);
      onQrScanned(qr);
    }, {
      highlightScanRegion: true,
      returnDetailedScanResult: false
    });

    try{
      await qrScanner.start();
      scanning = true;
      document.getElementById('scan-result').innerText = '🔍 Đang quét...';
      document.getElementById('start-btn').disabled = true;
      document.getElementById('stop-btn').disabled = false;
    }catch(err){
      console.error('Không thể truy cập camera', err);
      alert('Không thể truy cập camera. Hãy kiểm tra quyền camera hoặc mở trên HTTPS.');
    }
  }

  window.stopScanner = function(){
    if(qrScanner && scanning){
      qrScanner.stop();
    }
    scanning = false;
    document.getElementById('scan-result').innerText = '⏹ Đã dừng quét';
    document.getElementById('start-btn').disabled = false;
    document.getElementById('stop-btn').disabled = true;
  }

  // ================== onQrScanned (continuous: don't stop) ==================
  async function onQrScanned(qr){
    // show immediate ui
    document.getElementById('scan-result').innerHTML = `⏳ Xử lý QR: <b>${qr}</b>`;
    // Call your /api/scan
    try{
      const res = await fetch('/api/scan', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ user_id: currentUser.id, qr_code: qr })
      });
      // if backend sometimes returns non-json, wrap try/catch
      const data = await res.json().catch(()=>({ success: false, message: "Server trả về dữ liệu không hợp lệ" }));
      const addBtn = document.getElementById('add-new-btn');

      if(data && data.success){
        // update inventory local state
        document.getElementById('scan-result').innerHTML = `✅ Quét thành công: <b>${data.device.name}</b>`;
        addBtn.classList.add('hidden');
        let asset = assets.find(a => a.qr === qr);
        if(asset) asset.scanned = true;
        else assets.push({
          qr: qr,
          name: data.device.name,
          device_type: data.device.device_type_name || '-',
          dept: data.device.department_name || 'Chưa rõ',
          note: data.device.location || '',
          scanned: true
        });
        renderInventory();
        // show success toast + beep (but continue scanning)
        showScanSuccess(`✅ ${data.device.name}`);
      } else {
        // not found or error -> offer add
        const message = (data && data.message) ? data.message : 'Thiết bị không tồn tại';
        document.getElementById('scan-result').innerHTML = `⚠️ ${message}`;
        addBtn.classList.remove('hidden');
        document.getElementById('add-qr').value = qr;
        // also show toast for not found (optional style red)
        showScanError(message);
      }
    }catch(err){
      console.error('Lỗi gọi API /api/scan', err);
      document.getElementById('scan-result').innerText = '⚠️ Lỗi khi gọi API /api/scan';
      document.getElementById('add-new-btn').classList.remove('hidden');
      document.getElementById('add-qr').value = qr;
      showScanError('Lỗi server');
    } finally {
      // Important: DO NOT stop scanner -> continue scanning.
      // To avoid double processing same code because camera may still see it,
      // we used recentScans Map with DUPLICATE_WINDOW_MS.
    }
  }

  // ================== Toasts / sound ==================
  function showScanSuccess(message = '✅ Quét thành công!'){
    const toast = document.getElementById('scan-success-toast');
    const beep = document.getElementById('beep-sound');
    toast.textContent = message;
    // play beep
    try { beep.currentTime = 0; beep.play().catch(()=>{}); } catch(e){}
    // color green
    toast.classList.remove('hidden');
    toast.style.backgroundColor = '#16a34a';
    // auto hide
    setTimeout(()=>{ toast.classList.add('hidden'); }, 1200);
  }

  function showScanError(message = '⚠️ Lỗi'){
    const toast = document.getElementById('scan-success-toast');
    const beep = document.getElementById('beep-sound');
    toast.textContent = message;
    // short error beep (same sound for simplicity)
    try { beep.currentTime = 0; beep.play().catch(()=>{}); } catch(e){}
    // color red
    toast.classList.remove('hidden');
    toast.style.backgroundColor = '#dc2626';
    setTimeout(()=>{ toast.classList.add('hidden'); }, 1500);
  }

  // ================== LOAD DROPDOWNs và DEVICES ==================
  async function loadDropdowns(){
    try{
      // departments
      const resDepts = await fetch('/api/departments');
      if(resDepts.ok){
        const depts = await resDepts.json();
        const deptSelect = document.getElementById('add-department');
        deptSelect.innerHTML = '<option value="">-- Chọn bộ phận --</option>';
        depts.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.id; opt.textContent = d.name;
          deptSelect.appendChild(opt);
        });
      }

      // device types
      const resTypes = await fetch('/api/device-types');
      if(resTypes.ok){
        const types = await resTypes.json();
        const typeAdd = document.getElementById('add-device-type');
        const typeFilter = document.getElementById('device-filter');
        typeAdd.innerHTML = '<option value="">-- Chọn loại thiết bị --</option>';
        typeFilter.innerHTML = '<option value="">-- Tất cả loại thiết bị --</option>';
        types.forEach(t => {
          const optAdd = document.createElement('option');
          optAdd.value = t.id; optAdd.textContent = t.name;
          typeAdd.appendChild(optAdd);

          const optFilter = document.createElement('option');
          optFilter.value = t.name; optFilter.textContent = t.name;
          typeFilter.appendChild(optFilter);
        });
      }
    }catch(err){
      console.error('Lỗi loadDropdowns', err);
    }
  }

  async function loadDevices(){
    try{
      const res = await fetch('/api/devices');
      if(!res.ok) throw new Error('no devices');
      const data = await res.json();
      assets = data.map(d => ({
        id: d.id,
        name: d.name,
        qr: d.qr_code,
        device_type: d.device_type_name || '-',
        dept: d.department_name || d.department || 'Chưa rõ',
        department_id: d.department_id || (d.department && d.department.id) || null,
        note: d.location || '',
        scanned: d.status === "Đã quét" || d.status === "scanned"
      }));

      if(currentUser.role && currentUser.role !== "admin"){
        assets = assets.filter(a => a.department_id === currentUser.department_id);
      }
      renderInventory();
    }catch(err){
      console.warn('Không load được devices từ API, dùng mảng rỗng hoặc mock', err);
      assets = [];
      renderInventory();
    }
  }

  // ================== INVENTORY RENDER & FILTER ==================
  window.setStatusFilter = function(status){
    statusFilter = status;
    renderInventory();
  }

  function renderInventory(){
    const val = (document.getElementById('search')?.value || '').toLowerCase();
    const typeFilter = document.getElementById('device-filter')?.value || '';

    let filtered = assets.filter(a => {
      const matchesType = !typeFilter || a.device_type === typeFilter;
      const matchesStatus = statusFilter === 'all' ||
        (statusFilter === 'scanned' && a.scanned) ||
        (statusFilter === 'not_scanned' && !a.scanned);
      const matchesSearch = (a.name || '').toLowerCase().includes(val) || (a.qr || '').toLowerCase().includes(val);
      return matchesType && matchesStatus && matchesSearch;
    });

    // stats by dept
    const stats = {};
    filtered.forEach(a => stats[a.dept] = (stats[a.dept] || 0) + 1);
    const statsHtml = Object.entries(stats).map(([d,c]) => `
      <div class="bg-indigo-100 p-3 rounded-xl shadow text-center">
        <div class="font-bold text-indigo-600">${d}</div>
        <div class="text-lg">${c} thiết bị</div>
      </div>`).join('');
    document.getElementById('stats').innerHTML = statsHtml || '<div class="text-sm text-gray-500">Không có dữ liệu</div>';

    // inventory list
    const listHtml = filtered.map(a => `
      <div class="bg-gradient-to-r from-indigo-500 to-purple-500 text-white p-4 rounded-2xl shadow-md flex justify-between items-center">
        <div class="text-left">
          <div class="text-lg font-bold">${a.name} <span class="text-sm font-medium">(${a.device_type})</span></div>
          <div class="text-xs opacity-90">Mã QR: ${a.qr}</div>
          <div class="text-xs opacity-90">Bộ phận: ${a.dept}</div>
          <div class="text-xs opacity-90">${a.note || ''}</div>
        </div>
        <div class="ml-4">
          <span class="px-3 py-1 rounded-full text-sm ${a.scanned ? 'bg-green-400 text-green-900' : 'bg-red-400 text-red-900'}">
            ${a.scanned ? 'Đã quét' : 'Chưa quét'}
          </span>
        </div>
      </div>
    `).join('');
    document.getElementById('inventory-list').innerHTML = listHtml || '<div class="text-sm text-gray-500">Không có thiết bị</div>';
  }

  // ================== ADD DEVICE FORM ==================
  document.getElementById('add-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = new FormData(e.target);
    const payload = Object.fromEntries(form.entries());
    try{
      const res = await fetch('/api/devices', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if(data && data.success){
        const deptText = document.getElementById('add-department').selectedOptions[0]?.text || '';
        const typeText = document.getElementById('add-device-type').selectedOptions[0]?.text || '';
        assets.push({
          qr: payload.qr_code,
          name: payload.name,
          device_type: typeText,
          dept: deptText,
          note: payload.location || '',
          scanned: false
        });
        alert('✅ Đã thêm thiết bị!');
        e.target.reset();
        showTab('tab-inventory');
        renderInventory();
      } else {
        alert('❌ Lỗi thêm: ' + (data.message || 'Unknown'));
      }
    }catch(err){
      console.error('Lỗi khi thêm thiết bị', err);
      alert('❌ Lỗi server khi thêm thiết bị');
    }
  });

  // ================== TAB SWITCH ==================
  window.showTab = function(tabId, btn){
    document.querySelectorAll('.tab').forEach(t => t.classList.add('hidden'));
    document.getElementById(tabId).classList.remove('hidden');
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('text-indigo-600'));
    if(btn) btn.classList.add('text-indigo-600');
    // update nav highlight by data-tab
    document.querySelectorAll('[data-tab]').forEach(el => el.classList.remove('text-indigo-600'));
    const nav = document.querySelector(`[data-tab="${tabId}"]`);
    if(nav) nav.classList.add('text-indigo-600');

    if(tabId === 'tab-inventory') renderInventory();
  }

  // ================== INIT ==================
  document.getElementById('search')?.addEventListener('input', renderInventory);
  document.getElementById('device-filter')?.addEventListener('change', renderInventory);

  async function init(){
    await loadCurrentUser();
    await loadDropdowns();
    await loadDevices();

    // default show scan tab
    showTab('tab-scan');

    // disable stop button initially
    document.getElementById('stop-btn').disabled = true;
  }

  init();

  // ================== UTIL ==================
  window.logout = function(){ window.location.href = '/logout'; };
  window.goAdmin = function(){ window.location.href = '/admin'; };

  // Dành cho máy PDA Zebra (DataWedge)
  const hiddenInput = document.createElement('input');
  hiddenInput.id = 'zebra-input';
  hiddenInput.type = 'text';
  hiddenInput.classList.add('hidden');
  document.body.appendChild(hiddenInput);
  hiddenInput.focus();

  // Lắng nghe mã quét gửi vào input
  hiddenInput.addEventListener('input', e => {
    const val = e.target.value.trim();
    if (val.length > 0) {
      // Respect duplicate window too
      if(canProcessQr(val)) {
        markQrProcessed(val);
        onQrScanned(val);
      }
      e.target.value = '';
    }
  });

  // Đảm bảo luôn autofocus khi nhấn phím scan
  document.addEventListener('click', () => hiddenInput.focus());
  document.addEventListener('keydown', () => hiddenInput.focus());

</script>

</body>
</html>
